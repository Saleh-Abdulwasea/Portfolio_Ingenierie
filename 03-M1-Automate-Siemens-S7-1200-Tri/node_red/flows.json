    {
        "id": "collect_detect",
        "type": "function",
        "z": "551e486cf1cf5f1b",
        "name": "Collecter 10 roues",
        "func": "let detection = msg.payload === true ? \"🟢 Roue détectée\" : \"🔴 Aucune roue\";\nlet tri = msg.payload === true ? \"✅ Triée\" : \"❌ Non triée\";\nlet heure = new Date().toLocaleTimeString();\n\nlet ligne = {\n    heure: heure,\n    detection: detection,\n    tri: tri\n};\n\nlet historique = flow.get(\"historique\") || [];\n\nif (msg.payload === true) {\n    historique.push(ligne);\n}\n\nif (historique.length > 10) {\n    historique = historique.slice(historique.length - 10);\n}\n\nflow.set(\"historique\", historique);\n\nreturn { payload: historique };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 880,
        "wires": [
