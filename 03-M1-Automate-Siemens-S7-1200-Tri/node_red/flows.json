    {
        "id": "prepare_data",
        "type": "function",
        "z": "551e486cf1cf5f1b",
        "name": "Préparer données dashboard",
        "func": "let detection = msg.payload === true ? \"🟢 Roue détectée\" : \"🔴 Aucune roue\";\nlet voyant_tri = msg.tri_en_cours === true ? \"✅ Tri en cours\" : \"❌\";\nlet tri = msg.roue_triee === true ? \"✅ Triée\" : \"❌ Non triée\";\nlet heure = new Date().toLocaleTimeString();\nlet vitesse = msg.vitesse || 0;\n\n// Pour le tableau historique\nlet ligne = {\n  heure: heure,\n  detection: detection,\n  tri: tri\n};\n\n// Valeur pour le graphique (1 si roue détectée, 0 sinon)\nlet valeurGraph = msg.payload === true ? 1 : 0;\n\nreturn [\n  { payload: detection },     // Sortie 1 → Détection\n  { payload: tri },           // Sortie 2 → Triage\n  { payload: heure },         // Sortie 3 → Heure\n  { payload: vitesse },       // Sortie 4 → Vitesse moteur\n  { payload: [ligne] },       // Sortie 5 → Tableau historique\n  { payload: valeurGraph },    // ✅ Sortie 6 → Graphe\n  { payload: voyant_tri }    // Sortie 7 → LED Tri en cours\n];\n",
        "outputs": 7,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 600,
        "wires": [
            [
                "detection_text"
            ],
            [
                "tri_text"
            ],
            [
                "heure_text"
            ],
            [
                "vitesse_gauge"
            ],
            [],
            [],
            [
                "53089aed3d1539cb"
            ]
        ]
    },
